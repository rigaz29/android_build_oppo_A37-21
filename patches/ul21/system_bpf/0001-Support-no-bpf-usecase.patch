From c5d286c1a668153ac2e107e8b23eb50106181854 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Wed, 13 Oct 2021 10:56:52 -0400
Subject: [PATCH 1/2] Support no-bpf usecase

Change-Id: I75a427a2a41aa4ab1104ad88a891bef0dc2d9c91
---
 bpfloader/BpfLoader.cpp | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/bpfloader/BpfLoader.cpp b/bpfloader/BpfLoader.cpp
index 08fd72d..8c44db3 100644
--- a/bpfloader/BpfLoader.cpp
+++ b/bpfloader/BpfLoader.cpp
@@ -196,19 +196,20 @@ int main(int argc, char** argv) {
     //  which could otherwise fail with ENOENT during object pinning or renaming,
     //  due to ordering issues)
     for (const auto& location : locations) {
-        if (createSysFsBpfSubDir(location.prefix)) return 1;
+        if (createSysFsBpfSubDir(location.prefix)) {
+            goto fail;
+        }
     }
 
+    // Blok pembuatan /sys/fs/bpf/loader dari UL SENGAJA TIDAK diambil: official
+    // lineage-21.0 sudah tidak membuatnya di sini (nol kemunculan
+    // createSysFsBpfSubDir("loader") maupun fs_bpf_loader di berkas ini), jadi
+    // menambahkannya kembali akan menghidupkan langkah yang hulu memang buang.
+    // Yang dibutuhkan dari patch UL adalah bagian NON-FATAL-nya, bukan ini.
     // Load all ELF objects, create programs and maps, and pin them
     for (const auto& location : locations) {
         if (loadAllElfObjects(location) != 0) {
-            ALOGE("=== CRITICAL FAILURE LOADING BPF PROGRAMS FROM %s ===", location.dir);
-            ALOGE("If this triggers reliably, you're probably missing kernel options or patches.");
-            ALOGE("If this triggers randomly, you might be hitting some memory allocation "
-                  "problems or startup script race.");
-            ALOGE("--- DO NOT EXPECT SYSTEM TO BOOT SUCCESSFULLY ---");
-            sleep(20);
-            return 2;
+            goto fail;
         }
     }
 
@@ -217,5 +218,13 @@ int main(int argc, char** argv) {
         return 1;
     }
 
+    return 0;
+fail:
+    ALOGE("=== CRITICAL FAILURE LOADING BPF PROGRAMS ===");
+    ALOGE("If this triggers reliably, you're probably missing kernel options or patches.");
+    ALOGE("If this triggers randomly, you might be hitting some memory allocation "
+            "problems or startup script race.");
+    ALOGE("--- DO NOT EXPECT SYSTEM TO BOOT SUCCESSFULLY ---");
+    android::base::SetProperty("bpf.progs_loaded", "1");
     return 0;
 }
