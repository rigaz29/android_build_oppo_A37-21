<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest — LineageOS 21 (Android 14, SDK 34) untuk OPPO A37 / A37f / A37fw.

  Basis: LineageOS/android lineage-21.0 — OFFICIAL, sejak 14 Agustus 2026.

      repo init -u https://github.com/LineageOS/android.git -b lineage-21.0

  SEBELUMNYA basis LineageOS-UL, dan tree UL itulah yang pertama kali boot sampai
  setup wizard. Resep persisnya dibekukan di a37-21/A37-21-pinned-UL-bootok.xml
  (1451 project ter-pin ke SHA) dan ROM-nya di /root/rom-los21-UL-093028-BOOT-OK.zip,
  jadi rollback tetap mungkin. Objek git UL juga masih ada di .repo/project-objects.

  Karena basis pindah, berkas ini KEMBALI PANJANG: sembilan project. Blok di bawah
  yang menjelaskan "kelimanya DIBUANG" berlaku untuk basis UL dan kini kebalikannya
  — UL menyediakannya lewat snippets/losul.xml, official TIDAK.

  Diverifikasi terhadap manifest UL yang dulu ter-checkout, 10 Agustus 2026:

    losul.xml:12   device/qcom/sepolicy-legacy           lineage-21.0-legacy
    losul.xml:72   hardware/qcom-caf/msm8916/audio       lineage-21.0-caf-msm8916
    losul.xml:—    hardware/qcom-caf/msm8916/display     lineage-21.0-caf-msm8916
    losul.xml:—    hardware/qcom-caf/msm8916/media       lineage-21.0-caf-msm8916
    lineage.xml:163 hardware/sony/timekeep               lineage-21

  Kelimanya DULU ada di berkas ini dan sekarang DIBUANG — mempertahankannya berarti path
  ganda, dan repo sync akan menolak. Jangan menambahkannya kembali tanpa memeriksa dulu:

    grep -rn "<path yang mau ditambah>" .repo/manifests/*.xml .repo/manifests/snippets/*.xml

  Yang UL TIDAK sediakan dan tetap jadi pekerjaan kita (build/make bukan fork UL):
    - non_ab_ota.py `zip -y`                     patches/build_make/
    - PRODUCT_COMPRESSED_APEX := false            PLAN.md §4.8
    - Camera HAL1 device1/ (tak ada di UL 21)     patches/frameworks_av/
-->
<manifest>

  <remote name="gh" fetch="https://github.com/" />

  <!-- ================================================================
       hardware/qcom/wlan DIBUANG — menabrak nama modul
       ================================================================
       Repo ini melayani chip WLAN baru (wcn6740, wcn3990). A37 memakai qcwcn.
       Masalahnya bukan sekadar tak terpakai: ia mendefinisikan nama modul yang
       SAMA dengan library asli, tanpa soong_namespace —

         hardware/qcom/wlan/Android.bp:55
             wifihal_qcom_defaults { name: "libwifi-hal-qcom", ... }
         frameworks/opt/net/wifi/libwifi_hal/Android.bp:333
             wifi_cc_prebuilt_library_static { name: "libwifi-hal-qcom", ... }

       Modul `defaults` tidak punya varian build, sehingga dependensi
       libwifi-hal jatuh ke sana dan soong menolak:

         dependency "libwifi-hal-qcom" of "libwifi-hal" missing variant:
           os:android,image:vendor,arch:arm_armv8-a_cortex-a53,sdk:,link:static
         available variants:
           <kosong>

       Diverifikasi dengan menyingkirkan Android.bp-nya sementara: error itu
       hilang. Dan HAL qcwcn kita memang dibangun dari repo lain —
       frameworks/.../Android.bp:349 `wifi_makefile_goal make-libwifi-hal-qcom`
       mengambil hasil build hardware/qcom-caf/wlan/qcwcn/wifi_hal/Android.mk.
       Jadi membuangnya tidak menghilangkan apa pun yang kita pakai. -->
  <remove-project name="LineageOS/android_hardware_qcom_wlan" />

  <!-- Device tree. Basis: lineage-20 @ 15f7975 — tree yang ROM-nya TERPASANG dan masih
       DIPAKAI di perangkat per 10 Agustus 2026 (boot, Wi-Fi, Bluetooth, RIL berfungsi).

       Branch lineage-21-ul dibuat BARU dari titik itu, bukan melanjutkan lineage-21
       (percobaan pertama). Alasannya di PLAN.md §3.1: branch lama memuat workaround yang
       lahir dari basis official — BOARD_SEPOLICY_M4DEFS dan deklarasi sysfs_disk_stat —
       yang dengan basis UL sudah tidak berdasar. Memasang ulang secara sadar lebih jujur
       daripada mewarisi tumpukan yang alasannya sudah berubah. -->
  <project name="rigaz29/rb_device_oppo_A37" path="device/oppo/A37"
           remote="gh" revision="refs/heads/lineage-21-ul" upstream="lineage-21-ul" />

  <!-- Kernel 3.10.108 arm64, TANPA perubahan wajib. Android 14 tidak menambah syarat
       kernel keras di atas Android 13. ROM jangkar a6000 mengonfirmasi: kernel 3.10.108
       menjalankan A14 (versinya dipalsukan jadi 4.9.337 hanya agar lolos VTS — kita tidak
       menargetkan VTS, jadi spoof itu opsional; lihat PLAN.md §7). -->
  <project name="rigaz29/kernel_oppo_msm8939" path="kernel/oppo/msm8939"
           remote="gh" revision="refs/heads/lineage-21" upstream="lineage-21" />

  <!-- Vendor blobs. Tidak berubah sejak 18.1; 320 blob, 0 hilang di proyek 20.
       Percobaan pertama mengukur 162 dependensi DT_NEEDED: 5 tak tersedia, dan kelimanya
       juga tidak ada di ROM 20 yang berjalan — jadi nol regresi. -->
  <project name="rigaz29/rb-vendor_oppo_A37" path="vendor/oppo"
           remote="gh" revision="2e5c6f7ffcccbbf1430f8fa13fc530e1cae5feab"
           upstream="lineage-18.1" />

  <!-- ================================================================
       ENAM PROYEK DI BAWAH: dibutuhkan lagi sejak basis pindah ke OFFICIAL
       ================================================================
       Header berkas ini menulis "dengan basis UL hanya tiga yang tersisa".
       Itu benar untuk UL. Di basis official kelimanya kembali jadi pekerjaan
       kita, plus dtbtool. Diverifikasi di manifest official yang TER-RESOLVE
       (`repo manifest`), bukan di snippet: nol kecocokan untuk msm8916.

       Ketiga HAL msm8916 TIDAK PUNYA PADANAN OFFICIAL untuk Android 14.
       Diperiksa langsung ke hulu dengan `git ls-remote` (opsi heads).
       Catatan: tanda hubung ganda TIDAK BOLEH muncul di komentar XML — itu yang
       membuat versi pertama blok ini ditolak parser di baris ini juga:

         LineageOS/android_hardware_qcom_{audio,display,media}
           punya  lineage-17.0/17.1/18.0/18.1/19.0-caf-msm8916
           TIDAK punya 20.0 maupun 21.0 untuk msm8916
           yang ada untuk LOS 21 hanya msm8953, msm8996, msm8998

       LineageOS mencabut msm8916 sebagai ultra-legacy; UL mempertahankannya dan
       branch lineage-21.0-caf-msm8916 adalah SATU-SATUNYA versi siap-A14.
       Mengambilnya dari UL bukan "kembali memakai basis UL": ini dukungan
       perangkat keras untuk SoC yang sudah ditinggalkan hulu, sederajat dengan
       blob vendor. Basis platform (art, bionic, frameworks, system) tetap
       official sepenuhnya. Alternatifnya mem-port lineage-19.0 ke A14 sendiri —
       pekerjaan yang sudah UL selesaikan.

       Revisi DIPAKU ke SHA yang sama dengan tree UL yang TERBUKTI boot sampai
       setup wizard (A37-21-pinned-UL-bootok.xml), supaya satu-satunya variabel
       yang berubah adalah basis platform, bukan HAL-nya juga.

       Bukti tiap proyek benar-benar dipakai perangkat ini, bukan disalin borongan:
         sepolicy-legacy  device/oppo/A37/BoardConfig.mk:508
         dtbtool          BoardConfig.mk:279  TARGET_CUSTOM_DTBTOOL := dtbToolOppo
         timekeep         device.mk:1001 (PRODUCT_PACKAGES) — dan servisnya memang
                          jalan di perangkat: ro.boottime.timekeep ada di
                          report/bootfail3/getprop.txt
       Dari 21 proyek yang ada di UL tapi tidak di official, HANYA keenam ini yang
       diambil. Sisanya (msm8952/8960/8974/8994, NFC, external/connectivity) milik
       SoC atau fitur lain dan sengaja ditinggalkan. -->

  <project name="LineageOS-UL/android_hardware_qcom_audio" path="hardware/qcom-caf/msm8916/audio"
           remote="gh" revision="1b2c9f8e95f74f724894cbbe89b92d16239aff26"
           upstream="lineage-21.0-caf-msm8916" />
  <project name="LineageOS-UL/android_hardware_qcom_display" path="hardware/qcom-caf/msm8916/display"
           remote="gh" revision="c9d61b95f6ad6aebc5d2f33837b036dc55ac9365"
           upstream="lineage-21.0-caf-msm8916" />
  <project name="LineageOS-UL/android_hardware_qcom_media" path="hardware/qcom-caf/msm8916/media"
           remote="gh" revision="ee0cb10a3b8388bd24f78530b64204aeb185affc"
           upstream="lineage-21.0-caf-msm8916" />

  <project name="LineageOS-UL/android_device_qcom_sepolicy" path="device/qcom/sepolicy-legacy"
           remote="gh" revision="3fc6662b09bae2307a64cce5dca8e28ef43edc70"
           upstream="lineage-21.0-legacy" />
  <project name="LineageOS-UL/android_system_tools_dtbtool" path="system/tools/dtbtool"
           remote="gh" revision="ffd4bcb0e07a135e9bb65b07e33f6c8f5f1c47b9"
           upstream="lineage-21.0" />
  <project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep"
           remote="gh" revision="11c1535c71b97f0ab833e215a8121ed107235010"
           upstream="lineage-21" />

</manifest>
